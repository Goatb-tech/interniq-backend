APP_NAME=InternIQ
APP_VERSION=1.0.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interniq
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/interniq

SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=["pdf","doc","docx"]

CORS_ORIGINS=["http://localhost:3000"]

OPENAI_API_KEY=
